{
  "name": "generative-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local creative-coding studio for making generative artwork with p5.js and Three.js, driven by Claude Code.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "render": "node scripts/render-artwork.mjs",
    "render:grid": "node scripts/render-grid.mjs",
    "validate": "node scripts/validate-artworks.mjs",
    "check": "npm run validate && npm run build",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "p5": "^1.11.10",
    "three": "^0.185.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  }
}
